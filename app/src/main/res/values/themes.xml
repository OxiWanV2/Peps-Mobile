<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PepsMobile" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="WidgetLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
